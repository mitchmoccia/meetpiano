# Copy to .env.local for local work. Never commit real values.
# Vercel provides VERCEL_ENV, VERCEL_URL, and VERCEL_BRANCH_URL; do not set them yourself.

# Neon development branch. Pooled URL for the app, direct URL for migrations and operator scripts.
# Production uses its own Neon branch, configured only in Vercel's Production environment.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.us-east-1.aws.neon.tech/meetpiano?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-example.us-east-1.aws.neon.tech/meetpiano?sslmode=verify-full

# At least 32 characters, different in every environment: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Public origin of this deployment. Production requires https://meetpiano.app. Leave unset on previews.
BETTER_AUTH_URL=http://localhost:3000

# capture stores email in the development database for /dev/mailbox (reserved test domains only).
# sendgrid delivers real email and is required in production.
EMAIL_TRANSPORT=capture
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=MeetPiano

# pnpm db:seed only: password for the synthetic seed parents (10+ characters).
SEED_PARENT_PASSWORD=

# Playwright reads these from the shell, not from this file.
# E2E_BASE_URL targets a deployment instead of the local server on port 3100.
# E2E_BASE_URL=https://your-preview.vercel.app
# E2E_BROWSER_CHANNEL=chrome
# VERCEL_AUTOMATION_BYPASS_SECRET=
