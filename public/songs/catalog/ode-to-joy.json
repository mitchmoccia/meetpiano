    { "beat": 0, "text": "Joyful, joyful, we adore thee" },
    { "beat": 8, "text": "Hearts unfold like flowers before thee" },
    { "beat": 16, "text": "Melt the clouds of sin and sadness" },
    { "beat": 24, "text": "Drive the dark of doubt away" }
