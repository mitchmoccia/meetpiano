  "lyrics": [
    {
      "beat": 0,
      "text": "Baa, baa, black sheep, have you any wool"
    },
    {
      "beat": 16,
      "text": "Yes sir, yes sir, three bags full"
    },
    {
      "beat": 32,
      "text": "One for my master, one for the dame"
    }
  ],
