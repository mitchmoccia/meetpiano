  "provenance": {
    "source": "Traditional English nursery rhyme. The words appear in Tommy Thumb’s Pretty Song Book (about 1744). The tune is the same public-domain melody as Twinkle, Twinkle, Little Star (Ah! vous dirai-je, maman); the lyrics here are the distinct black-sheep verse.",
    "publicationYear": 1744,
    "publicDomain": true,
    "arrangement": "Original simple arrangement written for MeetPiano. Not copied from a copyrighted method book."
