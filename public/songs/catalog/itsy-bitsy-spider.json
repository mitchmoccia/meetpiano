  "lyrics": [
    {
      "beat": 0,
      "text": "The itsy bitsy spider climbed up the water spout"
    },
    {
      "beat": 16,
      "text": "Down came the rain and washed the spider out"
    },
    {
      "beat": 24,
      "text": "Out came the sun and dried up all the rain"
    }
